
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '0004657f3bb1a5784db794206781fa59579a'
	option packet_steering '2'
	option steering_flows '128'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '10.0.0.252/24'
	option ip6ifaceid 'eui64'
	option gateway '10.0.0.251'
	list dns '127.0.0.1'
	option delegate '0'

